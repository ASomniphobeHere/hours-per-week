  "estimators": [
    {
      "id": "arith.freqDuration",
      "activityId": "sleep",
      "inputs": ["sleep.bed.wd", "sleep.wake.wd", "sleep.bed.we", "sleep.wake.we"],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          { "kind": "clockSpan", "from": "sleep.bed.wd", "to": "sleep.wake.wd", "dayType": "wd" },
          { "kind": "clockSpan", "from": "sleep.bed.we", "to": "sleep.wake.we", "dayType": "we" }
        ]
      }
    },
    {
      "id": "arith.freqDuration",
      "activityId": "work",
      "inputs": ["work.hours.wd", "work.hours.we"],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          { "kind": "duration", "field": "work.hours.wd", "dayType": "wd" },
          { "kind": "duration", "field": "work.hours.we", "dayType": "we" }
        ]
      }
    },
    {
      "id": "arith.freqDuration",
      "activityId": "commute",
      "inputs": ["commute.minutes.wd", "commute.minutes.we"],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          { "kind": "duration", "field": "commute.minutes.wd", "dayType": "wd" },
          { "kind": "duration", "field": "commute.minutes.we", "dayType": "we" }
        ]
      }
    },
    {
      "id": "arith.freqDuration",
      "activityId": "eating",
      "inputs": ["eating.meals.wd", "eating.minutes.wd", "eating.meals.we", "eating.minutes.we"],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          {
            "kind": "freqDuration",
            "freq": "eating.meals.wd",
            "duration": "eating.minutes.wd",
            "dayType": "wd"
          },
          {
            "kind": "freqDuration",
            "freq": "eating.meals.we",
            "duration": "eating.minutes.we",
            "dayType": "we"
          }
        ]
      }
    },
    {
      "id": "household.v1",
      "activityId": "household",
      "inputs": ["household.size", "household.children", "household.partner", "work.status"],
      "outputs": ["wd", "we"],
      "params": {
        "wd": {
          "intercept": 1.0,
          "terms": [
            { "field": "household.size", "coef": 0.25 },
            { "field": "household.children", "coef": 0.35 },
            { "field": "household.partner", "levels": { "yes": 0.2, "no": 0 } },
            {
              "field": "work.status",
              "levels": { "full": 0, "part": 0.3, "self": 0.2, "none": 0.8 }
            }
          ]
        },
        "we": {
          "intercept": 1.65,
          "terms": [
            { "field": "household.size", "coef": 0.3 },
            { "field": "household.children", "coef": 0.4 },
            { "field": "household.partner", "levels": { "yes": 0.25, "no": 0 } },
            {
              "field": "work.status",
              "levels": { "full": 0, "part": 0.1, "self": 0.1, "none": 0.3 }
            }
          ]
        }
      }
    },
    {
      "id": "arith.freqDuration",
      "activityId": "care",
      "inputs": ["care.minutes.wd", "care.minutes.we"],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          { "kind": "duration", "field": "care.minutes.wd", "dayType": "wd" },
          { "kind": "duration", "field": "care.minutes.we", "dayType": "we" }
        ]
      }
    },
    {
      "id": "arith.freqDuration",
      "activityId": "hygiene",
      "inputs": ["hygiene.minutes.wd", "hygiene.minutes.we"],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          { "kind": "duration", "field": "hygiene.minutes.wd", "dayType": "wd" },
          { "kind": "duration", "field": "hygiene.minutes.we", "dayType": "we" }
        ]
      }
    },
    {
      "id": "arith.freqDuration",
      "activityId": "admin",
      "inputs": ["admin.times.wd", "admin.minutes.wd", "admin.times.we", "admin.minutes.we"],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          {
            "kind": "freqDuration",
            "freq": "admin.times.wd",
            "duration": "admin.minutes.wd",
            "dayType": "wd"
          },
          {
            "kind": "freqDuration",
            "freq": "admin.times.we",
            "duration": "admin.minutes.we",
            "dayType": "we"
          }
        ]
      }
    },
    {
      "id": "arith.freqDuration",
      "activityId": "leisure",
      "inputs": [
        "leisure.screen.wd",
        "leisure.social.wd",
        "leisure.other.wd",
        "leisure.screen.we",
        "leisure.social.we",
        "leisure.other.we"
      ],
      "outputs": ["wd", "we"],
      "params": {
        "terms": [
          { "kind": "duration", "field": "leisure.screen.wd", "dayType": "wd" },
          { "kind": "duration", "field": "leisure.social.wd", "dayType": "wd" },
          { "kind": "duration", "field": "leisure.other.wd", "dayType": "wd" },
          { "kind": "duration", "field": "leisure.screen.we", "dayType": "we" },
          { "kind": "duration", "field": "leisure.social.we", "dayType": "we" },
          { "kind": "duration", "field": "leisure.other.we", "dayType": "we" }
        ]
      }
    }
  ],

